# Hermes Agent — Coolify Deployment Config
#
# Copy to .env and fill in values. Compose files read from this automatically.

# UID/GID for file ownership inside the container (match your host user)
HERMES_UID=1000
HERMES_GID=1000

# API Server
API_SERVER_ENABLED=true
API_SERVER_KEY=sk_your-api-key-here
API_SERVER_CORS_ORIGINS=*
GATEWAY_ALLOW_ALL_USERS=false

# Zora paths & ports
ZORA_DATA=/home/angrynrrd/zoraToo
ZORA_API_PORT=8645
ZORA_DASHBOARD_PORT=9120

# Vicki paths & ports
VICKI_DATA=/home/angrynrrd/hermes
VICKI_API_PORT=8642
VICKI_DASHBOARD_PORT=8788
VICKI_TEAMS_PORT=3978

# Obsidian vault — shared notes mounted into both agents at /opt/vault
# (mount is read-write; see docker-compose.*.yml to switch to read-only)
OBSIDIAN_VAULT=/home/angrynrrd/Nextcloud/Shady/files

# MS Teams (Vicki only)
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=
TEAMS_TENANT_ID=
TEAMS_ALLOWED_USERS=

# LLM Provider
OPENAI_API_KEY=your-api-key-here
